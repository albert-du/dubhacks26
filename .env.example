# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for /api/cron/cleanup (if you run cleanup from a cron instead of the worker)
CRON_SECRET=change-me

# --- MongoDB (primary document store) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dump

# --- TigerData (Postgres/Timescale metrics) — optional ---
TIGERDATA_URL=postgres://postgres:postgres@localhost:5432/dump

# --- Vultr Object Storage (S3-compatible) — optional; falls back to ./.data/storage ---
S3_ENDPOINT=
S3_REGION=ewr1
S3_BUCKET=dump-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Perceptron vision (OCR, captions, candid scoring, subject boxes) ---
PERCEPTRON_API_KEY=
PERCEPTRON_BASE_URL=https://api.perceptron.inc/v1
PERCEPTRON_MODEL=isaac-0.1

# --- Face embedding service (services/face-embed, deploy on a Vultr GPU/CPU box) ---
FACE_EMBED_URL=http://localhost:8001
FACE_MATCH_THRESHOLD=0.42

# --- Video transcription (any OpenAI-compatible /audio/transcriptions endpoint, e.g. Whisper on Vultr) ---
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Photon 2.0 messaging agent ---
PHOTON_API_URL=
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=change-me
NEXT_PUBLIC_PHOTON_NUMBER=

# --- Backboard realtime fan-out — optional; SSE fallback always works ---
BACKBOARD_URL=
BACKBOARD_API_KEY=
