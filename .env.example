# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for /api/cron/cleanup (if you run cleanup from a cron instead of the worker)
CRON_SECRET=change-me

# --- MongoDB (primary document store) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dump

# --- TigerData (Postgres/Timescale metrics) — optional ---
TIGERDATA_URL=postgres://postgres:postgres@localhost:5432/dump

# --- Vultr Object Storage (S3-compatible) — optional; falls back to ./.data/storage ---
S3_ENDPOINT=
S3_REGION=ewr1
S3_BUCKET=dump-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Perceptron vision (objects, people, writing, captions, venue). Optional. ---
PERCEPTRON_API_KEY=
PERCEPTRON_BASE_URL=https://api.perceptron.inc/v1
PERCEPTRON_MODEL=perceptron-mk1.5

# --- Face embedding service (services/face-embed, deploy on a Vultr GPU/CPU box) ---
FACE_EMBED_URL=http://localhost:8001
FACE_MATCH_THRESHOLD=0.42

# --- Video transcription (any OpenAI-compatible /audio/transcriptions endpoint, e.g. Whisper on Vultr) ---
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Photon 2.0 messaging (https://api.photon.codes/v1) ---
# Project id (pho_prj_...) and bearer key (pho_sk_... or pho_ask_...).
# Key needs project:read, project:write, platforms:read, and platforms:write for registration.
# Optional fallback agent id for manual sends/local simulator; verified alerts use their saved route.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
# Shared iMessage: the homepage registers participants up to the 25-slot project cap.
# The homepage looks up their assigned number; Me verifies alerts with a one-time message.
PHOTON_PLATFORM=imessage
# Standard Webhooks signing secret (whsec_...). Also accepted as x-photon-secret for local curls.
PHOTON_WEBHOOK_SECRET=change-me
# Optional. Defaults to https://api.photon.codes/v1
# PHOTON_API_URL=

# --- Backboard — optional. Ask the pool, and Photon texts that aren't a fixed command. ---
# Key from https://app.backboard.io (sent as X-API-Key). Live updates stay on SSE either way.
# BACKBOARD_URL=https://app.backboard.io/api
BACKBOARD_API_KEY=
