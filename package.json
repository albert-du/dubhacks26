{
  "name": "dump",
  "version": "0.1.0",
  "private": true,
  "description": "Dump (dumpster.photo) — ephemeral, zero-login photo & video sharing for group events.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/**/*.test.ts",
    "audit:privacy": "tsx scripts/privacy-audit.ts",
    "audit:veyzl": "tsx scripts/veyzl-review.ts",
    "brand": "tsx scripts/brand.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.14.0",
    "mongodb": "^6.12.0",
    "nanoid": "^5.0.9",
    "next": "^15.3.0",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.38.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
