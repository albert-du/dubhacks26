# --- App ---
NEXT_PUBLIC_APP_URL=https://dumpster.photo
# Shared secret for /api/cron/cleanup (if you run cleanup from a cron instead of the worker)
CRON_SECRET=

# --- MongoDB (primary document store) ---
# Required: Atlas Drivers URI, including a URL-encoded password.
MONGODB_URI=''
MONGODB_DB=dump

# --- TigerData (Postgres/Timescale metrics) — optional ---
# Optional: hosted Tiger connection URL with sslmode=require; run sql/tigerdata.sql.
TIGERDATA_URL=''

# --- Cloudflare R2 (S3-compatible); blank endpoint uses the shared media volume ---
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (no bucket path).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=dump-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Perceptron vision (objects, people, text, captions, and subject boxes) ---
PERCEPTRON_API_KEY=
PERCEPTRON_BASE_URL=https://api.perceptron.inc/v1
PERCEPTRON_MODEL=perceptron-mk1.5

# --- Face embedding service (services/face-embed, deploy on a Vultr GPU/CPU box) ---
FACE_EMBED_URL=http://face-embed:8001
FACE_MATCH_THRESHOLD=0.42

# --- Internal CPU Whisper transcription (Speaches) ---
TRANSCRIBE_URL=http://whisper:8000/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=Systran/faster-whisper-small

# --- Photon 2.0 messaging (https://api.photon.codes/v1) ---
# Project id (pho_prj_...), bearer key (pho_sk_... or pho_ask_...) with project:write,
# and the iMessage agent User id (pho_usr_...) for the assigned line that sends.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
# Shared iMessage: register the test sender and use its assigned agent number.
PHOTON_PLATFORM=imessage
# Standard Webhooks signing secret (whsec_...). Also accepted as x-photon-secret for local curls.
PHOTON_WEBHOOK_SECRET=
# Optional. Defaults to https://api.photon.codes/v1
PHOTON_API_URL=https://api.photon.codes/v1
# Number guests text, shown on the landing page.
NEXT_PUBLIC_PHOTON_NUMBER=

# --- Backboard — optional. Ask the pool, and Photon texts that aren't a fixed command. ---
# Key from https://app.backboard.io (sent as X-API-Key). Live updates stay on SSE either way.
BACKBOARD_URL=https://app.backboard.io/api
BACKBOARD_API_KEY=

# Host listener; use an HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=3000
# Leave CPU headroom for Whisper and face embedding.
WORKER_MEDIA_LANES=1
